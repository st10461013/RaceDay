@model JsonElement?
@{ViewData["Title"]="My profile";}@if(Model.HasValue){var u=Model.Value;<div class="row justify-content-center"><div class="col-lg-7"><div class="card p-4"><div class="eyebrow text-success">Account settings</div><h1 class="section-title">Your profile</h1><p class="muted">@u.GetProperty("email").GetString() · @u.GetProperty("role").GetString()</p>@if(u.TryGetProperty("profileImageUrl",out var pic)&&pic.ValueKind==JsonValueKind.String){<img src="@pic.GetString()" alt="Profile picture" class="rounded-circle mb-3" style="width:110px;height:110px;object-fit:cover"/>}<form asp-action="Picture" method="post" enctype="multipart/form-data" class="mb-3"><label class="form-label">Profile picture</label><input type="file" name="picture" accept="image/png,image/jpeg,image/webp" class="form-control"/><button class="btn btn-outline-secondary mt-2">Upload picture</button></form><form asp-action="Update" method="post"><label class="form-label mt-3">First name</label><input name="firstName" class="form-control" value="@u.GetProperty("firstName").GetString()" required/><label class="form-label mt-3">Last name</label><input name="lastName" class="form-control" value="@u.GetProperty("lastName").GetString()" required/><label class="form-label mt-3">Phone number</label><input name="phoneNumber" class="form-control" value="@u.GetProperty("phoneNumber").ToString()"/><button class="btn btn-primary mt-4">Save profile</button></form></div></div></div>}
