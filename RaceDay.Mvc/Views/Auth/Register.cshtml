@model RegisterVm
@{ViewData["Title"]="Register";}<div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card p-4 p-md-5"><div class="eyebrow text-success">Join the community</div><h1 class="section-title">Create your account</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Role" class="form-label mt-3">Account type</label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select><div class="row"><div class="col"><label asp-for="FirstName" class="form-label mt-3"></label><input asp-for="FirstName" class="form-control"/></div><div class="col"><label asp-for="LastName" class="form-label mt-3"></label><input asp-for="LastName" class="form-control"/></div></div><label asp-for="Email" class="form-label mt-3"></label><input asp-for="Email" class="form-control"/><label asp-for="PhoneNumber" class="form-label mt-3"></label><input asp-for="PhoneNumber" class="form-control"/><label asp-for="Password" class="form-label mt-3"></label><input asp-for="Password" type="password" class="form-control"/><small class="muted">At least 8 characters, including a letter and a number.</small><label asp-for="OrganiserAccessCode" class="form-label mt-3">Organiser access code (Organisers only)</label><input asp-for="OrganiserAccessCode" class="form-control"/><button class="btn btn-primary w-100 mt-4">Create account</button></form></div></div></div>
