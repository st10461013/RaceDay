@using System.Text.Json
@{ViewData["Title"]="Manage event";JsonElement? ev=ViewBag.Event;var cats = ViewBag.Categories is JsonElement categories
    ? categories.EnumerateArray().ToList()
    : new List<JsonElement>();var ens=ViewBag.Enrolments is JsonElement en?en.EnumerateArray().ToList():new List<JsonElement>();var results=ViewBag.Results is JsonElement rr?rr.EnumerateArray().ToList():new List<JsonElement>();int id=ev?.GetProperty("eventId").GetInt32()??0;}
@if(ev.HasValue){<div class="d-flex justify-content-between flex-wrap gap-3"><div><div class="eyebrow text-success">Event operations</div><h1 class="section-title">@ev.Value.GetProperty("eventName").GetString()</h1><p class="muted">@ev.Value.GetProperty("eventDate").ToString() · @ev.Value.GetProperty("location").GetString()</p></div><a class="btn btn-outline-secondary align-self-start" asp-action="Index">← Dashboard</a></div>
<div class="row g-3 my-2"><div class="col-md-4"><div class="stat"><span class="muted">Categories</span><strong>@cats.Count</strong></div></div><div class="col-md-4"><div class="stat"><span class="muted">Enrolments</span><strong>@ens.Count(x=>x.GetProperty("status").GetString()!="Cancelled")</strong></div></div><div class="col-md-4"><div class="stat"><span class="muted">Results recorded</span><strong>@results.Count</strong></div></div></div>
<div class="card p-4 my-4"><h2 class="h4 section-title">Race categories</h2><div class="table-responsive"><table class="table"><thead><tr><th>Category</th><th>Distance</th><th>Capacity</th><th>Enrolled</th><th>Fee</th><th>Update</th><th></th></tr></thead><tbody>@foreach(var c in cats){<tr><td>@c.GetProperty("categoryName").GetString()</td><td>@c.GetProperty("distanceKM").GetDecimal() km</td><td>@c.GetProperty("maxParticipants").GetInt32()</td><td>@c.GetProperty("enrolledCount").GetInt32()</td><td>R @c.GetProperty("entryFee").GetDecimal()</td><td><form asp-action="UpdateCategory" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@c.GetProperty("categoryId").GetInt32()"/><input type="hidden" name="eventId" value="@id"/><input type="hidden" name="CategoryName" value="@c.GetProperty("categoryName").GetString()"/><input name="DistanceKM" type="number" step=".1" min=".1" value="@c.GetProperty("distanceKM").GetDecimal()" class="form-control form-control-sm" style="width:80px"/><input name="MaxParticipants" type="number" min="1" value="@c.GetProperty("maxParticipants").GetInt32()" class="form-control form-control-sm" style="width:80px"/><input name="EntryFee" type="number" step=".01" min="0" value="@c.GetProperty("entryFee").GetDecimal()" class="form-control form-control-sm" style="width:80px"/><button class="btn btn-sm btn-outline-primary">Save</button></form></td><td><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.GetProperty("categoryId").GetInt32()"/><input type="hidden" name="eventId" value="@id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div><h3 class="h6 mt-3">Add a category</h3><form asp-action="AddCategory" method="post" class="row g-2"><input type="hidden" name="id" value="@id"/><div class="col-md-4"><input class="form-control" name="CategoryName" placeholder="Category name" required/></div><div class="col-md-2"><input class="form-control" name="DistanceKM" type="number" step=".1" min=".1" placeholder="km" required/></div><div class="col-md-2"><input class="form-control" name="MaxParticipants" type="number" min="1" value="100" placeholder="Capacity"/></div><div class="col-md-2"><input class="form-control" name="EntryFee" type="number" min="0" step=".01" value="0" placeholder="Fee (R)"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Add</button></div></form></div>
<div class="card p-4 my-4"><h2 class="h4 section-title">Participant enrolments</h2><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Bib</th><th>Status</th></tr></thead><tbody>@foreach(var e in ens){<tr><td>@e.GetProperty("participantName").GetString()</td><td>@e.GetProperty("participantEmail").GetString()</td><td>@e.GetProperty("categoryName").GetString()</td><td>@e.GetProperty("bibNumber").ToString()</td><td><span class="badge @(e.GetProperty("status").GetString()=="Confirmed"?"bg-success":e.GetProperty("status").GetString()=="Pending"?"bg-warning text-dark":"bg-secondary")">@e.GetProperty("status").GetString()</span></td></tr>}</tbody></table></div></div>
<div class="card p-4 my-4"><h2 class="h4 section-title">Capture race results</h2><p class="muted">Enter finishing time and position once the event has concluded.</p><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Finish time</th><th>Position</th><th></th></tr></thead><tbody>@foreach(var e in ens.Where(x=>x.GetProperty("status").GetString()!="Cancelled")){<tr><form asp-action="SaveResult" method="post"><input type="hidden" name="id" value="@e.GetProperty("enrolmentId").GetInt32()"/><input type="hidden" name="eventId" value="@id"/><td>@e.GetProperty("participantName").GetString()</td><td>@e.GetProperty("categoryName").GetString()</td><td><input name="finishTime" type="time" step="1" class="form-control"/></td><td><input name="position" type="number" min="1" class="form-control"/></td><td><select name="status" class="form-select form-select-sm mb-1"><option>Finished</option><option>DNF</option><option>DSQ</option></select><button class="btn btn-sm btn-primary">Publish</button></td></form></tr>}</tbody></table></div></div>
<div class="card p-4"><h2 class="h4 section-title">Published results</h2><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var r in results){<tr><td>@r.GetProperty("participantName").GetString()</td><td>@r.GetProperty("categoryName").GetString()</td><td>@r.GetProperty("finishTime").ToString()</td><td>@r.GetProperty("position").ToString()</td><td>@r.GetProperty("status").GetString()</td></tr>}</tbody></table></div></div>}
