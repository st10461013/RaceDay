@model List<JsonElement>
@{ViewData["Title"]="Organiser dashboard";var stats=(List<(JsonElement ev,int enrol)>)ViewBag.Stats;}
<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow text-success">Race control</div><h1 class="section-title">Organiser dashboard</h1><p class="muted">Your events at a glance.</p></div><a class="btn btn-primary" asp-action="CreateEvent">＋ Create event</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat"><span class="muted">Events created</span><strong>@Model.Count</strong></div></div><div class="col-md-4"><div class="stat"><span class="muted">Total enrolments</span><strong>@stats.Sum(x=>x.enrol)</strong></div></div><div class="col-md-4"><div class="stat"><span class="muted">Upcoming events</span><strong>@Model.Count(e=>DateOnly.Parse(e.GetProperty("eventDate").ToString())>=DateOnly.FromDateTime(DateTime.Today))</strong></div></div></div>
<div class="row g-3">@foreach(var s in stats){var e=s.ev;var id=e.GetProperty("eventId").GetInt32();<div class="col-12"><div class="card p-3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3"><div><span class="pill">@e.GetProperty("eventType").GetString()</span><h3 class="h5 fw-bold mt-2 mb-1">@e.GetProperty("eventName").GetString()</h3><span class="muted">@e.GetProperty("eventDate").ToString() · @e.GetProperty("location").GetString() · @s.enrol enrolments</span></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-action="Manage" asp-route-id="@id">Manage</a><a class="btn btn-outline-secondary" asp-action="EditEvent" asp-route-id="@id">Edit</a><form asp-action="DeleteEvent" method="post"><input type="hidden" name="id" value="@id"/><button class="btn btn-outline-danger" onclick="return confirm('Delete this event and its related records?')">Delete</button></form></div></div></div></div>}</div>
