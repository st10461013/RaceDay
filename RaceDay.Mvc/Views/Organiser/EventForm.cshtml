@model EventVm
@{var edit=Model.EventId>0;ViewData["Title"]=edit?"Edit event":"Create event";}<div class="row justify-content-center"><div class="col-lg-8"><div class="card p-4"><div class="eyebrow text-success">Event setup</div><h1 class="section-title">@(edit?"Edit event":"Create an event")</h1><form method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="EventId" type="hidden"/><label asp-for="EventName" class="form-label mt-3">Event name</label><input asp-for="EventName" class="form-control"/><label asp-for="Description" class="form-label mt-3"></label><textarea asp-for="Description" rows="4" class="form-control"></textarea><div class="row"><div class="col-md-6"><label asp-for="EventDate" class="form-label mt-3"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="Location" class="form-label mt-3"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6"><label asp-for="DistanceKM" class="form-label mt-3">Event distance (km)</label><input asp-for="DistanceKM" class="form-control"/></div><div class="col-md-6"><label asp-for="EventType" class="form-label mt-3"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div><label asp-for="WeatherLocationCode" class="form-label mt-3">Weather location code (e.g. ZA-CT)</label><input asp-for="WeatherLocationCode" class="form-control"/><label class="form-label mt-3">Event banner image</label><input type="file" name="banner" accept="image/png,image/jpeg,image/webp" class="form-control"/><small class="muted">PNG, JPG or WebP. Upload is handled by the Part 2 API.</small>@if(!string.IsNullOrEmpty(Model.BannerImageUrl)){<img src="@Model.BannerImageUrl" class="img-fluid rounded mt-3" style="max-height:180px"/>}<button class="btn btn-primary mt-4">@(edit?"Save changes":"Create event")</button></form></div></div></div>
