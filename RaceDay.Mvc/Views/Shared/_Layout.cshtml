@using System.Text.Json
@{var raw=Context.Session.GetString("User"); string? role=null;string? name=null;if(raw!=null){try{using var u=JsonDocument.Parse(raw);role=u.RootElement.GetProperty("role").GetString();name=u.RootElement.GetProperty("firstName").GetString();}catch{}}}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-dark raced-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RACEDAY</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center"> <a class="nav-link" asp-controller="Home" asp-action="Index">Events</a>@if(role=="Organiser"){<a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">Create event</a>}else if(role=="Participant"){<a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My enrolments</a><a class="nav-link" asp-controller="Participant" asp-action="Results">My results</a>}@if(role!=null){<a class="nav-link" asp-controller="Profile" asp-action="Index">@name · Profile</a><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm ms-lg-2">Sign out</button></form>}else{<a class="nav-link" asp-controller="Auth" asp-action="Login">Sign in</a><a class="btn btn-lime btn-sm ms-lg-2" asp-controller="Auth" asp-action="Register">Join RaceDay</a>}</div></div></div></nav><main class="container py-4"><partial name="_Alerts"/>@RenderBody()</main><footer class="footer mt-5"><div class="container py-4">RACEDAY <span>· Run your race. Own your finish.</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
