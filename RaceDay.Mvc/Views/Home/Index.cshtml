@model JsonElement?
@{ViewData["Title"]="Discover events";var events=Model.HasValue&&Model.Value.ValueKind==JsonValueKind.Array?Model.Value.EnumerateArray().ToList():new List<JsonElement>();}
<section class="hero mb-4"><div class="eyebrow">Find your next finish line</div><h1>Every kilometre has a story.</h1><p class="lead">Discover running, walking and cycling events. Pick your distance. Make your day count.</p><a class="btn btn-lime btn-lg" asp-controller="Auth" asp-action="Register">Get started</a></section>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3"><div><div class="eyebrow text-success">On the calendar</div><h2 class="section-title mb-0">Upcoming events</h2></div><form class="d-flex gap-2" method="get"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search events or locations"/><select class="form-select" name="type"><option value="">All types</option>@foreach(var t in new[]{"Run","Walk","Cycle"}){<option selected="@(ViewBag.Type==t)" value="@t">@t</option>}</select><button class="btn btn-primary">Filter</button></form></div>
<div class="row g-4">@foreach(var e in events){var id=e.GetProperty("eventId").GetInt32();var date=e.GetProperty("eventDate").ToString();var banner=e.TryGetProperty("bannerImageUrl",out var b)?b.GetString():null;<div class="col-md-6 col-xl-4"><article class="card event-card">@if(!string.IsNullOrWhiteSpace(banner)){<img class="event-banner w-100" src="@banner" alt="Event banner"/>}else{<div class="event-banner d-flex align-items-center justify-content-center"><span class="display-4">🏃</span></div>}<div class="card-body"><span class="pill">@e.GetProperty("eventType").GetString()</span><h3 class="h5 fw-bold mt-3">@e.GetProperty("eventName").GetString()</h3><p class="muted mb-2">📍 @e.GetProperty("location").GetString()</p><p class="muted">📅 @date · @e.GetProperty("distanceKM").GetDecimal() km</p><a class="btn btn-primary w-100" asp-controller="Participant" asp-action="Details" asp-route-id="@id">View event</a></div></article></div>}</div>@if(events.Count==0){<div class="card p-5 text-center"><h3>No events found yet</h3><p class="muted">Try changing your filters or check back soon.</p></div>}
