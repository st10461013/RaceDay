@model JsonElement?
@{ViewData["Title"]="My results";var rows=Model.HasValue&&Model.Value.ValueKind==JsonValueKind.Array?Model.Value.EnumerateArray().ToList():new List<JsonElement>();}<div class="eyebrow text-success">Every finish tells a story</div><h1 class="section-title">My race history</h1><div class="card p-3 mt-3"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var r in rows){<tr><td>@r.GetProperty("eventName").GetString()</td><td>@r.GetProperty("eventDate").ToString()</td><td>@r.GetProperty("categoryName").GetString()</td><td>@r.GetProperty("finishTime").ToString()</td><td>@(r.GetProperty("position").ValueKind==JsonValueKind.Number?r.GetProperty("position").GetInt32()+" of "+rows.Count(x=>x.GetProperty("categoryId").GetInt32()==r.GetProperty("categoryId").GetInt32()):"—")</td><td>@r.GetProperty("status").GetString()</td></tr>}</tbody></table></div>@if(rows.Count==0){<p class="muted text-center">Your results will appear here after an organiser publishes them.</p>}</div>
