@model JsonElement?
@{ViewData["Title"]="Event details";var cats=ViewBag.Categories is JsonElement c?c.EnumerateArray().ToList():new List<JsonElement>();}<a asp-action="Index" class="text-decoration-none">← All events</a>@if(Model.HasValue){var e=Model.Value;var banner=e.TryGetProperty("bannerImageUrl",out var b)?b.GetString():null;<div class="card p-4 p-md-5 mt-3">@if(banner!=null){<img src="@banner" class="img-fluid rounded mb-4" style="max-height:280px;object-fit:cover"/>}<span class="pill align-self-start">@e.GetProperty("eventType").GetString()</span><h1 class="section-title mt-3">@e.GetProperty("eventName").GetString()</h1><p class="muted">📅 @e.GetProperty("eventDate").ToString() · 📍 @e.GetProperty("location").GetString() · @e.GetProperty("distanceKM").GetDecimal() km</p><p>@e.GetProperty("description").ToString()</p></div><h2 class="section-title mt-4">Available categories</h2><div class="row g-3">@foreach(var c in cats){<div class="col-md-6"><div class="card p-4"><h3 class="h5">@c.GetProperty("categoryName").GetString()</h3><p class="muted">@c.GetProperty("distanceKM").GetDecimal() km · R @c.GetProperty("entryFee").GetDecimal() · @c.GetProperty("enrolledCount").GetInt32()/@c.GetProperty("maxParticipants").GetInt32() places</p><form asp-action="Enrol" method="post"><input type="hidden" name="id" value="@c.GetProperty("categoryId").GetInt32()"/><input type="hidden" name="eventId" value="@e.GetProperty("eventId").GetInt32()"/><button class="btn btn-primary" disabled="@(c.GetProperty("enrolledCount").GetInt32()>=c.GetProperty("maxParticipants").GetInt32())">Enrol now</button></form></div></div>}</div>}
