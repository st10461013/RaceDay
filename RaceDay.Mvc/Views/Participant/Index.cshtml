@model JsonElement?
@{ViewData["Title"]="Find an event";var events=Model.HasValue&&Model.Value.ValueKind==JsonValueKind.Array?Model.Value.EnumerateArray().ToList():new List<JsonElement>();}<div class="eyebrow text-success">Your next challenge</div><h1 class="section-title">Find an event to enter</h1><p class="muted">Choose an event and a category to secure your place.</p><div class="row g-4">@foreach(var e in events){<div class="col-md-6 col-xl-4"><div class="card p-4 h-100"><span class="pill">@e.GetProperty("eventType").GetString()</span><h3 class="h5 fw-bold mt-3">@e.GetProperty("eventName").GetString()</h3><p class="muted">@e.GetProperty("eventDate").ToString() · @e.GetProperty("location").GetString()</p><p>@e.GetProperty("distanceKM").GetDecimal() km</p><a class="btn btn-primary mt-auto" asp-action="Details" asp-route-id="@e.GetProperty("eventId").GetInt32()">Explore categories</a></div></div>}</div>@if(events.Count==0){<div class="card p-5 text-center">No upcoming events are available right now.</div>}
