@model JsonElement?
@{ViewData["Title"]="My enrolments";var rows=Model.HasValue&&Model.Value.ValueKind==JsonValueKind.Array?Model.Value.EnumerateArray().ToList():new List<JsonElement>();}<div class="eyebrow text-success">Your race calendar</div><h1 class="section-title">My enrolments</h1><div class="card p-3 mt-3"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Bib number</th><th>Status</th></tr></thead><tbody>@foreach(var e in rows){<tr><td>@e.GetProperty("eventName").GetString()</td><td>@e.GetProperty("eventDate").ToString()</td><td>@e.GetProperty("categoryName").GetString()</td><td>@e.GetProperty("bibNumber").ToString()</td><td><span class="badge @(e.GetProperty("status").GetString()=="Confirmed"?"bg-success":e.GetProperty("status").GetString()=="Pending"?"bg-warning text-dark":"bg-secondary")">@e.GetProperty("status").GetString()</span></td></tr>}</tbody></table></div>@if(rows.Count==0){<p class="muted text-center">You haven't enrolled in an event yet.</p>}</div>
